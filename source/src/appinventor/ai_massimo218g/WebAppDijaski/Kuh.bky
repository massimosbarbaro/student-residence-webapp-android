                </value>
                <value name="PIECE">
                  <block type="text" id="15">
                    <field name="TEXT">http://</field>
                  </block>
                </value>
              </block>
            </value>
            <value name="B">
              <block type="text_contains" id="16">
                <value name="TEXT">
                  <block type="component_set_get" id="17">
                    <mutation component_type="TextBox" set_or_get="get" property_name="Text" is_generic="false" instance_name="Url"></mutation>
                    <field name="COMPONENT_SELECTOR">Url</field>
                    <field name="PROP">Text</field>
                  </block>
                </value>
                <value name="PIECE">
                  <block type="text" id="18">
                    <field name="TEXT">https://</field>
                  </block>
                </value>
              </block>
            </value>
          </block>
        </value>
        <statement name="DO0">
          <block type="component_method" id="19" inline="false">
            <mutation component_type="WebViewer" method_name="GoToUrl" is_generic="false" instance_name="WebViewer1"></mutation>
