  <block type="component_event" id="47" x="-71" y="338">
    <mutation component_type="Form" is_generic="false" instance_name="NOCNA" event_name="BackPressed"></mutation>
    <field name="COMPONENT_SELECTOR">NOCNA</field>
    <statement name="DO">
      <block type="controls_if" id="48" inline="false">
        <mutation else="1"></mutation>
        <comment pinned="false" h="91" w="403">If we can go back, we call GoBack procedure. If we cannot go back, meaning no more web page to go back to, we go to the previous screen.</comment>
        <value name="IF0">
          <block type="component_method" id="49">
            <mutation component_type="WebViewer" method_name="CanGoBack" is_generic="false" instance_name="WebViewer1"></mutation>
            <field name="COMPONENT_SELECTOR">WebViewer1</field>
          </block>
        </value>
        <statement name="DO0">
          <block type="procedures_callnoreturn" id="50">
            <mutation name="GoBack"></mutation>
            <field name="PROCNAME">GoBack</field>
          </block>
        </statement>
        <statement name="ELSE">
          <block type="controls_closeScreen" id="51"></block>
        </statement>
      </block>
    </statement>
  </block>
